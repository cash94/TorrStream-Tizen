<?xml version="1.0" encoding="UTF-8"?>
<!--
  TorrStream для Samsung Tizen. Пакет — только запускалка (index.html): разметку
  интерфейса она берёт с сервера TorrStream и пишет в свою страницу, поэтому
  access открыт для любого адреса (сервер можно сменить на свой).

  Все привилегии — уровня public: пакет ставят с сертификатом public (установщик
  с телефона, Tizen Studio без партнёрского). hostedapp_deviceapi_allow (Device
  API для страницы, открытой с сервера) была в 1.0.0 и 1.1.0 — уровня partner,
  с public-сертификатом установка падала (MISMATCHED_PRIVILEGE_LEVEL). С 1.1.0
  страница лежит в пакете, и Device API у неё есть без этой привилегии.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://torrstream.online/tizen" version="1.0.0" viewmodes="maximized">
    <tizen:application id="TorrStrm01.TorrStream" package="TorrStrm01" required_version="2.3"/>
    <tizen:profile name="tv-samsung"/>
    <name>TorrStream</name>
    <description>TorrStream — фильмы и сериалы через TorrServer</description>
    <author href="https://github.com/cash94">TorrStream</author>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>

    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:</tizen:content-security-policy>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/application.info"/>
    <!-- webapis.network.getIp(): страница ходит к службе ffprobe по IP
         телевизора — до localhost она на ТВ не достаёт -->
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <!-- Smart Hub Preview: карточки над ярлыком приложения в Smart Hub, как
         каналы Android TV. Ряды собирает фронтенд (js/tizen-preview.js) и
         отдаёт службе preview/service.js, а она системе
         (webapis.preview.setPreviewData). Система и сама будит службу раз в
         ~10 минут и после включения телевизора: тогда служба повторяет
         последние сохранённые карточки -->
    <tizen:metadata key="http://samsung.com/tv/metadata/use.preview" value="bg_service"/>
    <tizen:service id="TorrStrm01.preview" auto-restart="false" on-boot="false">
        <tizen:content src="preview/service.js"/>
        <tizen:name>TorrStream preview</tizen:name>
        <tizen:icon src="icon.png"/>
        <tizen:description>Smart Hub Preview</tizen:description>
        <tizen:category name="http://tizen.org/category/service"/>
    </tizen:service>
    <!-- Нажатие на карточку Smart Hub: запущенное приложение не
         перезагружается, а получает событие appcontrol с PAYLOAD -->
    <tizen:app-control>
        <tizen:src name="index.html" reload="disable"/>
        <tizen:operation name="http://samsung.com/appcontrol/operation/eden_resume"/>
    </tizen:app-control>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
